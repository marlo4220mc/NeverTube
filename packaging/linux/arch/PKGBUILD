# Maintainer: marlo4220mc <https://github.com/marlo4220mc>
#
# The PUBLISHED recipe (this is what goes to the AUR). It compiles the app
# INSIDE Arch, so the binary links Arch's own sonames instead of being a
# package cross-built for another distro.
#
# It is not what the CI builds: packaging/linux/arch/build.sh hands makepkg a
# GENERATED recipe whose source is a `git archive` of the checkout (that is how
# a commit gets validated before it is a release). This one is validated there
# instead (real version, real source, no placeholders) and it is the one a user
# installs.
#
# Bumping it: pkgver and the tag of `source` are the release version, and
# build.sh refuses a pkgver that does not match CMakeLists.txt, so the two move
# together. There is no hash to refresh: the source is a VCS one (see below).
pkgname=nevertube
pkgver=1.0.0
pkgrel=1
pkgdesc='NeverTube - lightweight YouTube client (Qt5 + libmpv)'
arch=('x86_64')
url='https://github.com/marlo4220mc/NeverTube'
license=('GPL-3.0-or-later')
depends=('qt5-base' 'mpv' 'ffmpeg' 'libpulse' 'libglvnd' 'openssl' 'hicolor-icon-theme')
# Native Wayland on a Wayland session (otherwise Qt goes through xcb/XWayland).
optdepends=('qt5-wayland: native Wayland instead of XWayland')
makedepends=('cmake' 'gcc' 'make' 'pkgconf' 'qt5-base' 'mpv' 'ffmpeg' 'libpulse')
# The source is the TAG of the release and not a tarball, on purpose: GitHub's
# archive tarballs are regenerated by GitHub itself, so their hash is not
# something this recipe can promise (and a stale hash is a package that builds
# for nobody). A git source is pinned by what the tag resolves to, makepkg does
# not verify a hash for it (`SKIP` is what every VCS recipe writes) and the
# checkout lands in $srcdir/nevertube, which is the directory build() enters.
# The AUR front page shows the tag this package builds.
source=("nevertube::git+https://github.com/marlo4220mc/NeverTube.git#tag=v$pkgver")
sha256sums=('SKIP')
options=('!debug')

build() {
  cd "$srcdir/nevertube"
  # No -DNEVERTUBE_VERSION: it is the DISPLAY spelling of a release
  # (1.0.0-alpha.1) and $pkgver is the pacman one (1.0.0.alpha.1), so passing it
  # would make the About box and the updater read a version nobody published.
  # Without it the app shows the PROJECT_VERSION of CMakeLists.txt, which is the
  # same core as the tag. The Flatpak takes the same decision.
  cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build --parallel "$(nproc)"
}

# Offline regression tests (no network, no GPU): the same "viability" gate the
# other distro builds run.
check() {
  cd "$srcdir/nevertube"
  export QT_QPA_PLATFORM=offscreen
  for t in --selftest-db --selftest-discover --selftest-ssl \
           --selftest-grid --selftest-theme --selftest-glyphs \
           --selftest-i18n --selftest-dates --selftest-suggest-parse \
           --selftest-suggest-panel --selftest-suggest-gestures \
           --selftest-av1hls --selftest-variants --selftest-reels \
           --selftest-download --selftest-download-button \
           --selftest-download-folder --selftest-download-settings \
           --selftest-download-transport --selftest-download-resume \
           --selftest-single-instance \
           --selftest-video-url --selftest-search-url --selftest-update \
           --selftest-mpris \
           --selftest-settings-page; do
    echo "SELFTEST $t"
    ./build/nevertube "$t"
  done
}

package() {
  cd "$srcdir/nevertube"
  DESTDIR="$pkgdir" cmake --install build --prefix /usr
}
